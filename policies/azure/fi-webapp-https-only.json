{
  "name": "fi-webapp-https-only",
  "properties": {
    "displayName": "Function and web apps must be HTTPS only",
    "description": "Denies App Service / Functions apps that accept plain HTTP.",
    "mode": "Indexed",
    "metadata": {
      "category": "Frosty Irie",
      "version": "1.0.0",
      "controls": [
        "NIST PR.DS-02",
        "ISO A.8.24",
        "SOC2 CC6.7"
      ]
    },
    "parameters": {
      "effect": {
        "type": "String",
        "defaultValue": "Deny",
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "metadata": {
          "displayName": "Effect"
        }
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.Web/sites"
          },
          {
            "field": "Microsoft.Web/sites/httpsOnly",
            "notEquals": "true"
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  }
}
